# Copy to .env (gitignored) and fill in real values. Never commit .env.

DD_API_KEY=

# TODO: fill in from https://docs.datadoghq.com/opentelemetry/setup/otlp_ingest/traces?tab=javascript
# with site = US1 (datadoghq.com) selected — that page renders the literal
# "${YOUR_ENDPOINT}" value for your site client-side, which this tool could
# not scrape (JS-rendered docs page). Should look like a full https:// URL
# ending in /v1/traces.
DD_OTLP_TRACES_ENDPOINT=

# TODO: same as above, from
# https://docs.datadoghq.com/opentelemetry/setup/otlp_ingest/logs?tab=javascript
# ending in /v1/logs. Note: that page says JS SDK logs export is still "in
# development" upstream — we're constructing the OTLP Logs JSON ourselves
# rather than depending on an official JS logs exporter, so the intake
# endpoint itself should still accept it as long as the payload is valid
# OTLP. Worth an early smoke test (see NOTES.md).
DD_OTLP_LOGS_ENDPOINT=

# Same application.id already used by the RUM-SDK version in the repo root.
DD_APPLICATION_ID=4a79b017-ea18-4839-9153-ce2b058b4db6

PROXY_PORT=8791
