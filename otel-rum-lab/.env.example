# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Confirmed by testing: the RUM app's own client token works here too —
# the same value already embedded in the root app's config.js (and
# therefore already public, unlike a real Datadog API key). Client
# tokens are designed to be exposed, so this is the lower-stakes choice;
# prefer it over generating a separate, broader-scoped API key just for
# this lab. (Why the OTLP intake accepts a client token in the dd-api-key
# slot isn't documented anywhere we've found — just confirmed empirically.)
DD_API_KEY=

# TODO: fill in from https://docs.datadoghq.com/opentelemetry/setup/otlp_ingest/traces?tab=javascript
# with site = US1 (datadoghq.com) selected — that page renders the literal
# "${YOUR_ENDPOINT}" value for your site client-side, which this tool could
# not scrape (JS-rendered docs page). Should look like a full https:// URL
# ending in /v1/traces.
DD_OTLP_TRACES_ENDPOINT=

# TODO: fill in from https://docs.datadoghq.com/opentelemetry/setup/otlp_ingest/logs?tab=javascript
# with site = US1 (datadoghq.com) selected. Note the path differs from
# traces: the official @opentelemetry/browser-sdk package's sample config
# uses .../api/v2/otlplogs for logs, not .../v1/logs — confirm which one
# your docs page actually renders for your site rather than assuming.
DD_OTLP_LOGS_ENDPOINT=

PROXY_PORT=8791
