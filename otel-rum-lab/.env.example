# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Confirmed by testing: the RUM app's own client token works here too —
# the same value already embedded in the root app's config.js (and
# therefore already public, unlike a real Datadog API key). Client
# tokens are designed to be exposed, so this is the lower-stakes choice;
# prefer it over generating a separate, broader-scoped API key just for
# this lab. (Why the OTLP intake accepts a client token in the dd-api-key
# slot isn't documented anywhere we've found — just confirmed empirically.)
DD_API_KEY=

# US1 (datadoghq.com) endpoints, the same ones the page's Direct mode uses.
# For another site, swap the host (otlp.<site>).
DD_OTLP_TRACES_ENDPOINT=https://otlp.datadoghq.com/v1/traces
DD_OTLP_LOGS_ENDPOINT=https://otlp.datadoghq.com/api/v2/otlplogs

PROXY_PORT=8791
